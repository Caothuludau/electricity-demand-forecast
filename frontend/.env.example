# Copy to .env and adjust as needed. Vite only exposes VITE_* variables to the client.

# Base URL of the FastAPI backend.
# Default (empty): same origin — the Vite dev server proxies /api to http://127.0.0.1:8000.
# Set explicitly when the backend runs elsewhere, e.g.:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
